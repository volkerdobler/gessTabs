{
  "name": "gesstabs",
  "displayName": "gessTabs",
  "description": "gess.Tabs Support",
  "version": "0.2.9",
  "publisher": "volkerdobler",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/volkerdobler/gessTabs.git"
  },
  "license": "AFL-3.0",
  "main": "./out/extension",
  "icon": "images/gesstabs_icon.png",
  "contributes": {
    "languages": [
      {
        "id": "gesstabs",
        "aliases": [
          "gessTabs",
          "gess.Tabs"
        ],
        "extensions": [
          ".tab",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gesstabs",
        "scopeName": "source.gessTabs",
        "path": "./syntaxes/gessTabs.json"
      }
    ],
    "snippets": [
      {
        "language": "gesstabs",
        "path": "./snippets/snippets.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "gessTabs Configuration",
      "properties": {
        "gesstabs.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug messages in the console."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "watch": "tsc -watch -p ./",
    "pretest": "tsc --noEmit -p .",
    "test": "mocha -r ts-node/register test/**/*.spec.ts"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/glob": "^7.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.13",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "mocha": "^10.8.2",
    "prettier": "^2.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

{
	"table": {
		"prefix": "tab, table",
		"body": "table ${1:add }${3:name ${2:tabellenname} }${5:title ${4:tabletitle} }${7:cellelements ( ${6:cellelements} ) }${9:frameelements ( ${8:frameelements} ) }${11:tableformats ( ${10:tableformats} ) }${13:contentkey ${12:contentkey} }= ${14:#KopfTotal} by ${15:Variablen};\r\n",
		"description": "table - Befehl mit allen Optionen",
		"scope": "source.gesstabs"
	},
	"variable": {
		"prefix": "variable",
		"body": ["VARIABLE ${1:name} = ${2:sourcevar};"],
		"description": "VARIABLE - Deklaration einer einzelnen Variablen",
		"scope": "source.gesstabs"
	},
	"variables": {
		"prefix": "variables",
		"body": [
			"VARIABLES ${1:name}${2:1} TO ${1:name}${3:10} = ${4:1};"
		],
		"description": "VARIABLES - Deklaration eines Variablenbereichs mit fortlaufender Nummerierung",
		"scope": "source.gesstabs"
	},
	"recode": {
		"prefix": "recode",
		"body": [
			"RECODE ${1:1 2 3} = ${2:1}",
			"/ ${3:4 5} = ${4:2}",
			"ELSE = ${5:9};"
		],
		"description": "RECODE - Umkodierung von Werten",
		"scope": "source.gesstabs"
	},
	"valuelabels": {
		"prefix": "valuelabels",
		"body": [
			"VALUELABELS ${1:varname} =",
			"${2:1} \"${3:Label}\"",
			"${4:2} \"${5:Label}\"",
			";"
		],
		"description": "VALUELABELS - Zuweisung von Werte-Labels",
		"scope": "source.gesstabs"
	},
	"overcode": {
		"prefix": "overcode",
		"body": ["OVERCODE ${1:1 2} \"${2:Beschriftung}\""],
		"description": "OVERCODE - Zusammenfassung mehrerer Codes zu einer Überschrift",
		"scope": "source.gesstabs"
	},
	"compute": {
		"prefix": "compute",
		"body": [
			"COMPUTE ${1|add,alpha,ascend,copy,descend,eliminate,init,load,replace,shuffle,sort,swap|} ${2:zielvar} = ${3:ausdruck};"
		],
		"description": "COMPUTE - Neuberechnung/Ableitung einer Variablen (mit Options-Auswahl)",
		"scope": "source.gesstabs"
	},
	"weightcells": {
		"prefix": "weightcells",
		"body": [
			"WEIGHTCELLS ${1:varname} =",
			"${2:1} : ${3:50} %",
			"${4:2} : ${5:50} %",
			";"
		],
		"description": "WEIGHTCELLS - Gewichtung auf Zielprozente je Ausprägung",
		"scope": "source.gesstabs"
	},
	"macro": {
		"prefix": "#macro",
		"body": [
			"#MACRO #${1:name}( ${2:&param} )",
			"${3:; }",
			"#ENDMACRO"
		],
		"description": "#MACRO - Definition eines Macros",
		"scope": "source.gesstabs"
	},
	"domacro": {
		"prefix": "#domacro",
		"body": ["#DOMACRO( ${1:macroname} ${2:1}:${3:100} )"],
		"description": "#DOMACRO - wiederholter Macroaufruf über eine Zahlenfolge/Liste",
		"scope": "source.gesstabs"
	},
	"overview": {
		"prefix": "overview",
		"body": [
			"OVERVIEW = ${1:#Kopf} BY",
			"${2:MEAN} (",
			"${3:var1}",
			"${4:var2}",
			") SORT ${2:MEAN} DESCEND;"
		],
		"description": "OVERVIEW - Übersichtstabelle über mehrere Variablen",
		"scope": "source.gesstabs"
	},
	"xoverview": {
		"prefix": "xoverview",
		"body": [
			"XOVERVIEW = ${1:MEAN} (",
			"${2:var1}",
			"${3:var2}",
			") SORT ${1:MEAN} DESCEND",
			"BY ${4:#Kopf};"
		],
		"description": "XOVERVIEW - um 90° gedrehte Übersichtstabelle",
		"scope": "source.gesstabs"
	},
	"vargroup": {
		"prefix": "vargroup",
		"body": ["VARGROUP ${1:name} = ( ${2:var1} TO ${3:var2} ) EQ ${4:1};"],
		"description": "VARGROUP - Zusammenfassung einer Variablenliste zu einer Gruppenvariablen",
		"scope": "source.gesstabs"
	},
	"groups": {
		"prefix": "groups",
		"body": [
			"GROUPS ${1:varname} =",
			"\"${2:Label}\" : ${3:Bedingung}",
			";"
		],
		"description": "GROUPS - benannte Gruppen anhand logischer Bedingungen",
		"scope": "source.gesstabs"
	},
	"twobases": {
		"prefix": "#twobases",
		"body": [
			"#MACRO #twobases( &1 &2 )",
			"COMPUTE COPY &1_valid = &1;",
			"IF [ &2 ] IN &1 THEN COPY &1_invalid = &1 ELSE &1_invalid = 0;",
			"FILTER &1_valid = NOT ( [ &2 ] IN &1 );",
			"COPYLABELS &1_valid &1_invalid = &1;",
			"COPYTITLE &1_valid &1_invalid = &1;",
			"TITLE &1_invalid = '';",
			"LABELS &1_invalid = ADD",
			"0 \"nix\" LEVEL 252",
			";",
			"USECASES = YVALID;",
			"FRAMEELEMENTS = -ABSROW;",
			"TABLE = #k BY",
			"ABSOLUTE :DESCRIPTION \"Alle Fälle\" ()",
			"&1_valid",
			"ABSOLUTE :DESCRIPTION \"Gültige Fälle\" ( &1_valid )",
			"&1_invalid;",
			"#ENDMACRO"
		],
		"description": "#twobases - Cookbook-Macro (GESStabs_Basiswechsel.md) für eine Tabelle mit Gesamtbasis und gültiger Basis übereinander",
		"scope": "source.gesstabs"
	}
}
